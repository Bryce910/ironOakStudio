*credentials*.json
*credentials*.txt
*secret*.json
*.pem
*.key
node_modules/
__pycache__/
.pytest_cache/
.cache/
cache/
caches/
logs/
saves/
*.inputs.json
*.lock
*.progress
*.jsonl
*.log
*.bak
*.orig
*~
*Zone.Identifier
imgui.ini
studio-layout.ini
graphics.settings
player-profile.config
world.studio.workspace

# Local distributions, artist copies and the separate older browser prototype.
/exports/
/output/
/tmp/
/Valwood_Artist_Work/
/emberdeep-alpha/
/*.sha256
/CURRENT_VALWOOD.before-*.json
/CLAUDE_APARTMENT_HANDOFF.txt
/new_engine/builds/
/new_engine/releases/
/new_engine/assets/
/new_engine/models/
/new_engine/textures/
/new_engine/Tree_FBX/
/new_engine/glb_test/
/new_engine/ground/
/new_engine/background_music/
