# Keep documentation, without generated capture reports and frame dumps.
/new_engine/docs/**
!/new_engine/docs/**/
!/new_engine/docs/**/*.md
!/new_engine/docs/**/*.txt
/new_engine/docs/**/review/
/new_engine/docs/**/captures/
/new_engine/docs/**/frames/
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.txt

# Authored project text is tracked; licensed/cooked resources stay local.
/new_engine/projects/**/texture_blocks/
/new_engine/projects/**/assets/
/new_engine/projects/**/qa/
/new_engine/projects/**/model_cache/
/new_engine/projects/**/models/**
!/new_engine/projects/**/models/**/
!/new_engine/projects/**/models/**/*.inc
/new_engine/projects/**/textures/
/new_engine/projects/**/ground/
/new_engine/projects/**/audio/
/new_engine/projects/**/fonts/
/new_engine/projects/**/knights_roster/
/new_engine/projects/**/npc_knights/
/new_engine/projects/*backup*/

# Historical generations retain their launch and integration tools. The active
# source snapshot is explicitly versioned even though it lives under build/.
/new_engine/build/**
!/new_engine/build/*/
!/new_engine/build/*/*.py
!/new_engine/build/*/*.sh
!/new_engine/build/*/GUIDE.txt
!/new_engine/build/*/tools/
!/new_engine/build/*/tools/**/
!/new_engine/build/*/tools/**/*.py
!/new_engine/build/*/tools/**/*.sh
!/new_engine/build/*/tools/**/*.c
!/new_engine/build/*/tools/**/*.cpp
!/new_engine/build/*/tools/**/*.h
!/new_engine/build/*/tools/**/*.inc
!/new_engine/build/battlefield-opening-2026-11-22/source-v1/
!/new_engine/build/battlefield-opening-2026-11-22/source-v1/**
!/new_engine/build/battlefield-opening-2026-11-22/shared/
!/new_engine/build/battlefield-opening-2026-11-22/shared/shaders/
!/new_engine/build/battlefield-opening-2026-11-22/shared/shaders/**
!/new_engine/build/battlefield-opening-2026-11-22/READY_INPUTS.json
!/new_engine/build/battlefield-opening-2026-11-22/runtime-native-v1/
!/new_engine/build/battlefield-opening-2026-11-22/runtime-native-v1/BUILD_RECEIPT.json
/new_engine/build/**/__pycache__/
/new_engine/build/**/*.o
/new_engine/build/**/*.d
/new_engine/build/**/*.so
/new_engine/build/**/*Zone.Identifier

# Project specifications are authored documents, rather than packaged builds.
!/specs/*.docx
