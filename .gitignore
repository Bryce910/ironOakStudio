# Track source, documentation and authored text data by default.
# Large art/audio libraries and build products remain local.
*
!*/
!*.c
!*.cpp
!*.cc
!*.h
!*.hpp
!*.inc
!*.inl
!*.m
!*.mm
!*.mk
!Makefile
!CMakeLists.txt
!*.cmake
!*.py
!*.sh
!*.bat
!*.ps1
!*.js
!*.mjs
!*.ts
!*.tsx
!*.html
!*.css
!*.glsl
!*.fs
!*.vs
!*.hlsl
!*.md
!*.txt
!*.json
!*.yaml
!*.yml
!*.toml
!*.ini
!*.cfg
!*.config
!*.settings
!*.scene
!*.physics
!*.sky
!*.flames
!*.views
!*.studio
!*.valwood
!*.sql
!*.lock
!LICENSE*
!COPYING*
!NOTICE*
!.gitignore
!.gitattributes

