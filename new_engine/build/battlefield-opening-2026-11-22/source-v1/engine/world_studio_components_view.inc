            components_entity_combo("Scene entity",components_selected_entity);const char *body_name="Choose independently authored body";for(const auto &b:physics_document.bodies)if(b.id==components_selected_body)body_name=b.name.c_str();if(ImGui::BeginCombo("Physics body",body_name)){for(const auto &b:physics_document.bodies){ImGui::PushID(reinterpret_cast<const void *>(&b));if(ImGui::Selectable(b.name.c_str(),components_selected_body==b.id))components_selected_body=b.id;ImGui::PopID();}ImGui::EndCombo();}
