            for(unsigned i=0;i<components_document.physics.size();i++){ImGui::PushID(int(i));auto &binding=components_document.physics[i];ImGui::Text("%s | entity %llu -> body %llu",components_entity_name(binding.entity),(unsigned long long)binding.entity,(unsigned long long)binding.body);components_modified|=ImGui::InputDouble("Mesh pivot X",&binding.body_to_entity.position.x,.05,.5);components_modified|=ImGui::InputDouble("Mesh pivot Y",&binding.body_to_entity.position.y,.05,.5);components_modified|=ImGui::InputDouble("Mesh pivot Z",&binding.body_to_entity.position.z,.05,.5);if(ImGui::SmallButton("Remove physics binding")){components_document.physics.erase(components_document.physics.begin()+i);components_modified=true;ImGui::PopID();break;}ImGui::PopID();}
        }
        if(ImGui::CollapsingHeader("Logical schedules to scene actors")){
            components_entity_combo("Schedule scene entity",components_selected_entity);const char *actor_name="Choose logical actor";for(const auto &actor:living_world.definition().actors)if(actor.id==components_selected_living)actor_name=actor.name.c_str();if(ImGui::BeginCombo("Logical actor",actor_name)){for(const auto &actor:living_world.definition().actors){ImGui::PushID(reinterpret_cast<const void *>(&actor));if(ImGui::Selectable(actor.name.c_str(),actor.id==components_selected_living))components_selected_living=actor.id;ImGui::PopID();}ImGui::EndCombo();}
