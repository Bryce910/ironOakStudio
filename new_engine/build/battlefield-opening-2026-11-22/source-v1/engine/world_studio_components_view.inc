    const char *components_entity_name(world_runtime::Id id)const{if(const auto *n=world_entity::find(live.entities,id))return n->name.c_str();if(const auto *n=world_entity::find(components_demo.markers,id))return n->name.c_str();return "Missing entity";}
    bool components_entity_combo(const char *label,world_runtime::Id &id){bool changed=false;if(ImGui::BeginCombo(label,id?components_entity_name(id):"Choose persistent entity")){for(const auto &entity:components_entities){ImGui::PushID(reinterpret_cast<const void *>(&entity));if(ImGui::Selectable(components_entity_name(entity.id),id==entity.id)){id=entity.id;changed=true;}ImGui::PopID();}ImGui::EndCombo();}return changed;}
    static world_runtime::Pose components_offset(const world_runtime::Pose &body,const world_runtime::Pose &entity){
        const auto q=body.rotation;const double x=entity.position.x-body.position.x,y=entity.position.y-body.position.y,z=entity.position.z-body.position.z;const double tx=2*(-q.y*z+q.z*y),ty=2*(-q.z*x+q.x*z),tz=2*(-q.x*y+q.y*x);world_runtime::Pose out;out.position={x+q.w*tx-q.y*tz+q.z*ty,y+q.w*ty-q.z*tx+q.x*tz,z+q.w*tz-q.x*ty+q.y*tx};const auto r=entity.rotation;out.rotation={q.w*r.x-q.x*r.w-q.y*r.z+q.z*r.y,q.w*r.y+q.x*r.z-q.y*r.w-q.z*r.x,q.w*r.z-q.x*r.y+q.y*r.x-q.z*r.w,q.w*r.w+q.x*r.x+q.y*r.y+q.z*r.z};return out;
    }
