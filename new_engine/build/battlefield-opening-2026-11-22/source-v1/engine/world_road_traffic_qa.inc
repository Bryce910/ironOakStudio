 switch(road_qa_phase){
 case 1:if(age<12)return;if(opening_state.stage()!=world_opening_prologue::Stage::Title||!opening_have_save){road_qa_fail("Seeded title Continue unavailable");return;}road_qa_tap(SDLK_DOWN,frame);next(2);return;
 case 2:if(age<6)return;if(opening_title_selection!=1){road_qa_fail("Continue not focused");return;}road_qa_tap(SDLK_RETURN,frame);next(3);return;
 case 3:if(age<12||!first_journey_outdoors())return;if(!road_traffic_validated||world_road_traffic_count(road_traffic)!=31){if(++road_qa_ready_frames>90)road_qa_fail("Traffic did not become ready after loading");return;}if(opening_state.camp().spoken()){road_qa_fail("Untouched camp state invalid");return;}road_qa_begin_distance=world_road_traffic_stats(road_traffic).travelled;road_qa_begin_x=cam.x;road_qa_begin_z=cam.z;next(4);return;
 case 4:{if(!inventory_controls_ready||!opening_movement_armed||!opening_controls_enabled){road_qa_axes(0,0,0);return;}const double wanted=std::atan2(road_traffic_config.points[1].x-cam.x,-(road_traffic_config.points[1].z-cam.z));const double delta=std::remainder(wanted-cam.yaw,6.283185307179586);if(std::abs(delta)>.025){road_qa_axes(0,0,Sint16(std::copysign(32767.,delta)));return;}road_qa_axes(0,0,0);road_qa_pending="road-facing-start";next(5);return;}
 case 5:if(age<8)return;if(!opening_movement_armed||!opening_controls_enabled){road_qa_axes(0,0,0);return;}road_qa_axes(0,-32767,0);next(6);return;
 case 6:if(age<90)return;road_qa_axes(0,0,0);road_qa_pending="road-walking";next(7);return;
 case 7:if(age<8)return;road_qa_tap(SDLK_ESCAPE,frame);next(8);return;
 case 8:if(age<6)return;if(preview_screen!=2){road_qa_fail("Escape did not pause");return;}road_qa_pause_distance=world_road_traffic_stats(road_traffic).travelled;next(9);return;
 case 9:if(age<12)return;if(std::abs(world_road_traffic_stats(road_traffic).travelled-road_qa_pause_distance)>1e-8){road_qa_fail("Pause moved traffic");return;}road_qa_tap(SDLK_ESCAPE,frame);next(10);return;
 case 10:if(age==10)road_qa_pending="road-resumed";if(age<30)return;{const auto st=world_road_traffic_stats(road_traffic);if(preview_screen!=1||st.travelled<road_qa_pause_distance+1||st.travelled<road_qa_begin_distance+20||std::hypot(cam.x-road_qa_begin_x,cam.z-road_qa_begin_z)<3||st.failures||st.unsupported||opening_state.camp().spoken()){road_qa_fail("Actual movement/resume/assets or camp credit failed");return;}road_qa_done=true;running=false;return;}
 default:road_qa_fail("Bad phase");return;
 }
};
auto road_traffic_qa_capture=[&](int width,int height,uint64_t frame){
 if(!road_traffic_qa||!road_qa_frames)return;const auto st=world_road_traffic_stats(road_traffic);
 road_qa_frames<<"{\"frame\":"<<frame<<",\"phase\":"<<road_qa_phase<<",\"travelled\":"<<st.travelled<<",\"moving\":"<<st.moving<<",\"visible\":"<<st.visible<<",\"draws\":"<<st.draws<<",\"waiting\":"<<st.barrier_waiting<<",\"failures\":"<<st.failures<<",\"focused\":"<<(preview_pad.focused?"true":"false")<<",\"camera\":["<<cam.x<<','<<cam.y<<','<<cam.z<<','<<cam.yaw<<"],\"actors\":[";
 for(unsigned i=0;i<world_road_traffic_count(road_traffic);++i){WorldRoadTrafficActor a;if(!world_road_traffic_actor(road_traffic,i,&a))continue;road_qa_frames<<(i?",":"")<<'['<<a.id<<','<<unsigned(a.kind)<<','<<a.x<<','<<a.y<<','<<a.z<<','<<a.yaw<<','<<a.cycle_phase<<','<<a.wheel_angle<<']';}road_qa_frames<<"]}\n";
 if(road_qa_pending.empty())return;std::vector<unsigned char> pixels(size_t(width)*height*3),flipped(pixels.size());GLint align=4;glGetIntegerv(GL_PACK_ALIGNMENT,&align);glPixelStorei(GL_PACK_ALIGNMENT,1);glReadBuffer(GL_BACK);glReadPixels(0,0,width,height,GL_RGB,GL_UNSIGNED_BYTE,pixels.data());glPixelStorei(GL_PACK_ALIGNMENT,align);for(int y=0;y<height;++y)std::copy_n(pixels.data()+size_t(height-1-y)*width*3,size_t(width)*3,flipped.data()+size_t(y)*width*3);auto *surface=SDL_CreateRGBSurfaceWithFormatFrom(flipped.data(),width,height,24,width*3,SDL_PIXELFORMAT_RGB24);const bool ok=surface&&SDL_SaveBMP(surface,(road_qa_dir/(road_qa_pending+".bmp")).c_str())==0;if(surface)SDL_FreeSurface(surface);if(!ok||glGetError()!=GL_NO_ERROR)road_qa_fail("Framebuffer capture failed");else ++road_qa_captures;road_qa_pending.clear();
};
auto road_traffic_qa_finish=[&](){if(!road_traffic_qa)return;road_qa_frames.close();const auto st=world_road_traffic_stats(road_traffic);const bool pass=road_qa_done&&!road_qa_failed&&road_qa_captures==3;std::ofstream f(road_qa_dir/"ROAD_NATIVE_RAW.json");f<<"{\"passed\":"<<(pass?"true":"false")<<",\"error\":"<<world_json::quote(road_qa_error)<<",\"captures\":"<<road_qa_captures<<",\"actors\":"<<st.actors<<",\"travelled\":"<<st.travelled<<",\"draws\":"<<st.draws<<",\"actual_native_scene\":true,\"ordinary_continue_and_sdl_controls\":true,\"user_session_untouched\":true}\n";if(!pass||!f)launch->exit_code=1;std::fprintf(stderr,"[Road QA] %s\n",pass?"PASS":"FAIL");};
