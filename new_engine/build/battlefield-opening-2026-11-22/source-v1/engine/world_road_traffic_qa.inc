bool road_qa_done=false,road_qa_failed=false;double road_qa_pause_distance=0,road_qa_begin_distance=0,road_qa_begin_x=0,road_qa_begin_z=0;
std::string road_qa_error,road_qa_pending;std::filesystem::path road_qa_dir;
std::ofstream road_qa_frames;std::vector<std::pair<SDL_Keycode,uint64_t>> road_qa_keys;
