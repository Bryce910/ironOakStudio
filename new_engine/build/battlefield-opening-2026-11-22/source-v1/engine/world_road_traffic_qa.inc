auto road_traffic_qa_step=[&](uint64_t frame){
 if(!road_traffic_qa||road_qa_done||road_qa_failed)return;
 controller_test_pad.tick();for(auto it=road_qa_keys.begin();it!=road_qa_keys.end();){if(it->second<=frame){SDL_Event e={};e.type=SDL_KEYUP;e.key.windowID=SDL_GetWindowID(window);e.key.state=SDL_RELEASED;e.key.keysym.sym=it->first;e.key.keysym.unused=0x56414c54u;SDL_PushEvent(&e);it=road_qa_keys.erase(it);}else ++it;}
 if(road_qa_phase==0){const char *d=std::getenv("VALWOOD_QA_ROAD_DIR");if(!d||!road_traffic_loaded||!controller_test_pad.joystick){road_qa_fail("Missing owned runtime, output or SDL controller");return;}road_qa_dir=d;std::filesystem::create_directories(road_qa_dir);road_qa_frames.open(road_qa_dir/"frames.jsonl");road_qa_frames.precision(17);SDL_SetWindowSize(window,640,360);SDL_Event e={};e.type=SDL_WINDOWEVENT;e.window.windowID=SDL_GetWindowID(window);e.window.event=SDL_WINDOWEVENT_FOCUS_GAINED;SDL_PushEvent(&e);road_qa_phase=1;road_qa_since=frame;return;}
 const auto age=frame-road_qa_since;if(destination_loading)return;
