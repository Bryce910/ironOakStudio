        for(size_t i=0;i<conditions.size();i++){ImGui::PushID(int(i));auto &c=conditions[i];int kind=int(c.kind),op=int(c.compare);if(ImGui::Combo("Condition",&kind,"Flag\0Counter\0Quest state\0Encounter state\0Entity active\0Cooldown ready\0Event value (rules only)\0")){c.kind=game::ConditionKind(kind);c.key=0;edited=true;}
            switch(c.kind){case game::ConditionKind::Flag:edited|=gameplay_reference("Flag",gameplay_document.flags,c.key);break;case game::ConditionKind::Counter:edited|=gameplay_reference("Counter",gameplay_document.counters,c.key);break;case game::ConditionKind::Quest:edited|=gameplay_reference("Quest",gameplay_document.quests,c.key);break;case game::ConditionKind::Encounter:edited|=gameplay_reference("Encounter",gameplay_document.encounters,c.key);break;case game::ConditionKind::EntityActive:edited|=gameplay_reference("Entity",gameplay_document.entities,c.key);break;case game::ConditionKind::CooldownReady:edited|=gameplay_reference("Rule cooldown",gameplay_document.rules,c.key);break;case game::ConditionKind::EventValue:c.key=0;break;}
