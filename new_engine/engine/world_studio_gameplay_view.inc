    bool gameplay_text(const char *label,std::string &value,unsigned capacity=256){std::array<char,2049> buffer={};capacity=std::clamp(capacity,2u,2049u);std::snprintf(buffer.data(),capacity,"%s",value.c_str());if(!ImGui::InputText(label,buffer.data(),capacity))return false;value=buffer.data();return true;}
    bool gameplay_id(const char *label,world_gameplay::Id &id){return ImGui::InputScalar(label,ImGuiDataType_U64,&id);}
    template<class T>bool gameplay_reference(const char *label,const std::vector<T> &items,world_gameplay::Id &id,bool empty=false){
        const char *preview=empty&&id==0?"None / any":"Choose reference";for(const auto &item:items)if(item.id==id)preview=item.name.c_str();bool changed=false;
        if(ImGui::BeginCombo(label,preview)){if(empty&&ImGui::Selectable("None / any",id==0)){id=0;changed=true;}for(const auto &item:items){ImGui::PushID(reinterpret_cast<const void *>(&item));if(ImGui::Selectable(item.name.c_str(),item.id==id)){id=item.id;changed=true;}ImGui::PopID();}ImGui::EndCombo();}return changed;
    }
    world_gameplay::Id gameplay_next_id(world_gameplay::Id reserved=0)const{
        // Pick an unused low positive ID; scanning is bounded by the document
        // limits and cannot wrap when a loaded asset already uses UINT64_MAX.
        auto used=[&](world_gameplay::Id id){if(id==reserved)return true;auto in=[&](const auto &items){return std::any_of(items.begin(),items.end(),[&](const auto &v){return v.id==id;});};
            if(in(gameplay_document.entities)||in(gameplay_document.flags)||in(gameplay_document.counters)||in(gameplay_document.quests)||in(gameplay_document.encounters)||in(gameplay_document.triggers)||in(gameplay_document.dialogues)||in(gameplay_document.rules))return true;
            for(const auto &q:gameplay_document.quests)if(in(q.objectives))return true;
            for(const auto &d:gameplay_document.dialogues)if(in(d.lines))return true;
            return false;};
        world_gameplay::Id next=1;while(used(next))++next;return next;
    }
    void gameplay_checkpoint(const world_gameplay::Document &before){if(gameplay_undo.size()==32)gameplay_undo.erase(gameplay_undo.begin());gameplay_undo.push_back(before);gameplay_redo.clear();gameplay_dirty=true;}
    bool gameplay_conditions(std::vector<world_gameplay::Condition> &conditions){
